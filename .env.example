# Copy this file to .env and fill in real values.
# .env must be listed in .gitignore.

# Brevo API key. Create it under SMTP & API -> API Keys in the Brevo dashboard.
# Rotate it immediately if it is ever pasted into a chat, an issue, or a commit.
BREVO_API_KEY=

# The sender address. It must be verified as a sender in the Brevo account,
# otherwise Brevo rejects every send request with a 400.
BREVO_SENDER_EMAIL=

# Display name shown in the recipient's mail client.
BREVO_SENDER_NAME=your-name

# Where contact form submissions are forwarded.
CONTACT_RECIPIENT=example@domain.xxx

# Where new-subscriber notices are forwarded.
NEWSLETTER_RECIPIENT=example@domain.xxx

# Public base URL used to build absolute links inside outgoing email.
# Change this to the production domain before deploying.
PUBLIC_BASE_URL=https://example.com

# Origin allowed to call the API from a browser. Must match the site exactly,
# including scheme and with no trailing slash.
ALLOWED_ORIGIN=https://example.com
