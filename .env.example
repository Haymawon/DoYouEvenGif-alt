# Copy this file to .env and fill in real values.
# .env must be listed in .gitignore.

# API key issued by Brevo. Rotate it immediately if it is ever pasted into a
# chat, an issue, or a commit.
BREVO_API_KEY=

# Sender address. Must be verified as a sender with Brevo, otherwise every
# send request is rejected with a 400.
BREVO_SENDER_EMAIL=

# Display name shown in the recipient's mail client.
BREVO_SENDER_NAME=

# Where contact form submissions are forwarded.
CONTACT_RECIPIENT=

# Where new-subscriber notices are forwarded.
NEWSLETTER_RECIPIENT=
